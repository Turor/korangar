// Verdant Rune — default HUD theme (first-run and headless screenshots).
ThemeFile(
    name: "Verdant Rune",
    bg: "#0F1714",
    panel: "#17221E",
    raised: "#203029",
    border: "#34483F",
    text: "#E3EDE6",
    muted: "#93A69C",
    accent: "#4CC3A0",
    accent2: "#E0708A",
    hover: "#CFAE5A",
    hp: "#D2524A",
    sp: "#4A86D8",
    gold: "#CFAE5A",
    slot_size: 44.0,
    corner_radius: 8.0,
    font_size: 13.0,
    // Window and chat background opacity (1.0 = opaque).
    window_alpha: 1.0,
    // Status panel bars (status.hp_bar, status.sp_bar, status.base_exp_bar, status.job_exp_bar).
    status: (
        hp_bar: Some("#5CC25A"),
        sp_bar: Some("#4A86D8"),
        base_exp_bar: Some("#CFAE5A"),
        job_exp_bar: Some("#E0708A"),
    ),
)
